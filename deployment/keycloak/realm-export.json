        ]
      }
    },
    {
      "username": "dev.operator",
      "email": "operator@enterprise.com",
      "firstName": "Dev",
      "lastName": "Operator",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "OperatorPassword123!",
          "temporary": false
        }
      ],
      "realmRoles": [
