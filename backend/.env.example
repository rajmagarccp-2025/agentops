# Backend Environment Variables Template
APP_ENV=development
LOG_LEVEL=INFO
DEMO_MODE=false

# Database (SQLite default for local dev, PostgreSQL for docker/prod)
DATABASE_URL=sqlite:///./platform_dev.db

# Authentication & JWT
JWT_DEMO_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
JWT_ALGORITHM=HS256
JWT_ISSUER=agentic-platform
JWT_AUDIENCE=agentic-platform-api
JWT_DEMO_TOKEN_MINUTES=30

# CORS Origins (comma-separated or handled by FastAPI)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# Keycloak OIDC Configuration (Optional in local dev demo mode, enabled in prod SSO)
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=platform
KEYCLOAK_CLIENT_ID=platform-frontend
