# Frontend Environment Variables Template
# Copy to frontend/.env.local for local development

# Public API Base URL (accessible from browser)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Internal API Base URL (accessible from Next.js server-side node layer)
INTERNAL_API_BASE_URL=http://localhost:8000/api/v1

# Public support contact
NEXT_PUBLIC_SUPPORT_EMAIL=support@agentops.example

# Keycloak OIDC Configuration
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=agentops
KEYCLOAK_CLIENT_ID=agentops-web
KEYCLOAK_REDIRECT_URI=http://localhost:3000/api/auth/callback
