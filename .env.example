# Canonical environment variable configuration template.
# Copy to .env for local development. NEVER commit real secrets to source control.

# ==============================================================================
# 1. PUBLIC FRONTEND CONFIGURATION (Browser Access)
# ==============================================================================
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=agentops
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=agentops-web
NEXT_PUBLIC_SUPPORT_EMAIL=support@agentops.example

# ==============================================================================
# 2. INTERNAL DOCKER NETWORKING (Next.js Server / BFF)
# ==============================================================================
INTERNAL_API_BASE_URL=http://api:8000/api/v1
INTERNAL_KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=agentops
KEYCLOAK_CLIENT_ID=agentops-web

# ==============================================================================
# 3. BACKEND API & WORKER CONFIGURATION
# ==============================================================================
APP_ENV=development
LOG_LEVEL=INFO
DEMO_MODE=true

# Database (PostgreSQL + pgvector)
POSTGRES_DB=platform
POSTGRES_USER=platform
POSTGRES_PASSWORD=platform
DATABASE_URL=postgresql+psycopg://platform:platform@postgres:5432/platform
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800

# Redis Cache & Background Queue
REDIS_URL=redis://redis:6379/0

# Object Storage (S3 / Scality)
S3_ENDPOINT_URL=http://s3server:8000
S3_ACCESS_KEY=accessKey1
S3_SECRET_KEY=verySecretKey1
S3_BUCKET_NAME=platform-artifacts

# Local Demo Authentication (JWT)
JWT_DEMO_SECRET=local-demo-secret-change-me-32-bytes
JWT_ALGORITHM=HS256
JWT_ISSUER=agentic-platform
JWT_AUDIENCE=agentic-platform-api
JWT_DEMO_TOKEN_MINUTES=30

# Production / Enterprise OIDC Configuration
OIDC_ISSUER_URL=http://localhost:8080/realms/agentops
OIDC_CLIENT_ID=agentops-web
OIDC_AUDIENCE=agentops-api

# OpenTelemetry & Observability
OTEL_SERVICE_NAME=agentic-platform-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
