# Example Terraform Variables File for Multi-Cloud Deployment

# General Environment Configuration
environment = "production"
project_name = "agentic-platform"
owner        = "sre-platform-team"
cost_center  = "eng-ops-101"

# Primary Cloud Provider (aws | azure | gcp)
cloud_provider = "aws"
region         = "us-east-1"

# AWS Configuration
aws_account_id = "123456789012"
vpc_cidr       = "10.0.0.0/16"
eks_cluster_name = "agentic-platform-prod"
eks_node_instance_type = "t3.large"

# Azure Configuration
azure_subscription_id = "00000000-0000-0000-0000-000000000000"
azure_location        = "eastus"
aks_cluster_name      = "agentic-platform-aks"

# GCP Configuration
gcp_project_id  = "agentic-platform-gcp-prod"
gcp_region      = "us-central1"
gke_cluster_name = "agentic-platform-gke"

# Database & Cache
db_instance_class  = "db.t4g.medium"
db_name            = "platform"
db_admin_username  = "platform_admin"
redis_node_type    = "cache.t4g.micro"
